function [cartesian_orbit_matrix] = deltaV_ver2(r1_vec,orbit_matrix)
%Original function outputs: [delVAmag, delVBmag, delVA, delVB]
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Function Description: This function calculates the impulsive delta V
% required for a maneuver between escaping Earth's escape velocity and
% being inserted into the Cycler orbit.
% 
%   INPUT VARIABLES:
%   NAME : Description. (unit) 
%   r1_vec : Vector of the Earth's position with respect to the Sun. (km) 
%   otbit_matrix : State vector containing the state of Lambert Solutions
%   from the lambert Solver
%  
%   OUTPUT VARIABLES:
%   NAME : Description. (unit) 
%   delVAmag: Magnitude of delta V for A solutions
%   delVA: implusive delta V vector in heliocentric inertial coordinates
%   delVBmag: Magnitude of delta V for B solutions
%   delVB: implusive delta V vector in heliocentric inertial coordinates
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

%Loading characteristic values
char_values = load_characteristic_values();

cartesian_orbit_matrix = zeros(size(orbit_matrix(2),6)); % empty matrix of cartesian orbit matrix

%converting keplerian state matrix to heliocentric inertial cartesian vectors
%note that both states are inertial in the 2 body problem
%and hence no correction needs to be made with transport theorem, direct
%DCM conversion is possible
for solutionIndex = 1:size(orbit_matrix,1)
    converted_state = orb2cartOrig(orbit_matrix(solutionIndex,1),orbit_matrix(solutionIndex,2)...
        ,orbit_matrix(solutionIndex,3),orbit_matrix(solutionIndex,4),orbit_matrix(solutionIndex,5)...
        ,orbit_matrix(solutionIndex,6),char_values.mu);
    % assigning converted state to create the cartesian orbit state vector
    rx = converted_state(1); % Radius in x
    ry = converted_state(2);
    rz = converted_state(3);
    vx = converted_state(4); % velocity in x
    vy = converted_state(5);
    vz = converted_state(6);
    cartesian_orbit_matrix(solutionIndex,1) = rx; 
    cartesian_orbit_matrix(solutionIndex,2) = ry;
    cartesian_orbit_matrix(solutionIndex,3) = rz;
    cartesian_orbit_matrix(solutionIndex,4) = vx;
    cartesian_orbit_matrix(solutionIndex,5) = vy;
    cartesian_orbit_matrix(solutionIndex,6) = vz;
end

%Obtaining Earth's cartesian state at R1 % NEEED TO EXPLORE THIS FN THS
earthState = planetEphemeris(0, 'Sun', 'Earth', '4326', 'km');
earthPosition = earthState(1:3) + r1_vec(:).';
earthVelocity = earthState(4:6);


end